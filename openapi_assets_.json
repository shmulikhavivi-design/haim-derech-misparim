  <!--
    This is a single-page Redoc site served behind CloudFront's SPA fallback
    (custom_403/404 -> /index.html @ 200), so S3 misses return index.html with
    an HTTP 200 for ANY path. Only "/" (the home page), "/api" (the API
    reference) and "/mcp" (the MCP Server page) are real routes; every other
    path is treated as not-found. We flag the route before first paint so CSS can swap in the
    right view without a flash, and the app bootstrap below loads Redoc only
    for the API reference. Hash navigation (#tag/...) leaves pathname
    unchanged, so deep links within an allowed route are unaffected.
    The MCP page lives in this file (not its own .html) because the SPA
    fallback always serves index.html for unknown keys.

    NOTE: this is a client-side 404 — the HTTP status is still 200. A true
    edge-level 404 would need a CloudFront Function on the distribution.
  -->
  <script>
    (function () {
      var path = window.location.pathname;
      var home = path === '/';
      // The reference used to live on "/" — keep old /#tag/... deep links working
      if (home && /^#(tag|section|operation)\//.test(window.location.hash)) {
        window.location.replace('/api' + window.location.hash);
      }
      var api = path === '/api' || path === '/api/';
      var mcp = path === '/mcp' || path === '/mcp/';
      if (home) {
        window.__developersRoute = 'home';
        document.documentElement.className += ' route-home';
      } else if (mcp) {
        window.__developersRoute = 'mcp';
        document.documentElement.className += ' route-mcp';
      } else if (!api) {
        window.__developersNotFound = true;
        document.documentElement.className += ' route-not-found';
      }
    })();
  </script>
